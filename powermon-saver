#!/usr/bin/python3
"""Powermon energy-saver helper. Run as root (via pkexec): powermon-saver on|off|status

on  : CPU boost off, governor powersave, max freq = min freq; AMD GPU forced to
      lowest DPM level and power cap lowered to its minimum.
off : restores the values saved by 'on' (state kept in /run, so a reboot resets all).
Only fixed kernel sysfs paths are touched; saved values are validated before writing.
"""
import glob
import json
import os
import re
import sys

ROOT = ""
if os.geteuid() != 0:  # test hook: fake sysfs tree, never honoured when root
    ROOT = os.environ.get("POWERMON_FAKE_ROOT", "")
SAFE = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")
CARD = re.compile(r"^card[0-9]+$")


def rd(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def wr(path, val):
    if val is None or not SAFE.match(str(val)):
        return False
    try:
        with open(path, "w") as f:
            f.write(str(val))
        return True
    except OSError:
        return False


def targets():
    t = {}
    for d in sorted(glob.glob(f"{ROOT}/sys/devices/system/cpu/cpu[0-9]*/cpufreq")):
        t[f"{d}/scaling_governor"] = ("powersave", None)
        t[f"{d}/scaling_max_freq"] = (rd(f"{d}/cpuinfo_min_freq"), rd(f"{d}/cpuinfo_max_freq"))
    t[f"{ROOT}/sys/devices/system/cpu/cpufreq/boost"] = ("0", "1")
    seen = set()
    for d in sorted(glob.glob(f"{ROOT}/sys/class/drm/card*/device")):
        card = os.path.basename(os.path.dirname(d))
        real = os.path.realpath(d)
        if not CARD.match(card) or real in seen:  # skip connectors (card1-DP-1) and duplicates
            continue
        seen.add(real)
        t[f"{d}/power_dpm_force_performance_level"] = ("low", "auto")
        for h in glob.glob(f"{d}/hwmon/hwmon*"):
            lo = rd(f"{h}/power1_cap_min")
            if lo and lo.isdigit() and int(lo) > 0:  # some drivers report a bogus minimum of 0
                t[f"{h}/power1_cap"] = (lo, rd(f"{h}/power1_cap_default"))
    return t


STATE = f"{ROOT}/run/powermon-saver.json"


def on():
    t = targets()
    if not os.path.exists(STATE):
        prev = {p: rd(p) for p in t if rd(p) is not None}
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            json.dump(prev, f)
    failed = [p for p, v in t.items() if v[0] is not None and not wr(p, v[0])]
    print(f"saver on: {len(t) - len(failed)}/{len(t)} settings applied")
    for p in failed:
        print(f"  skipped: {p}", file=sys.stderr)


def off():
    t = targets()
    try:
        with open(STATE) as f:
            prev = json.load(f)
    except (OSError, ValueError):
        prev = {}
    n = 0
    for p, (_, default) in t.items():
        v = prev.get(p, default)
        if p.endswith("scaling_governor") and p not in prev:
            v = "schedutil"
        if p in prev or default is not None:
            n += wr(p, v)
    try:
        os.remove(STATE)
    except OSError:
        pass
    print(f"saver off: {n} settings restored")


def status():
    gov = rd(f"{ROOT}/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")
    boost = rd(f"{ROOT}/sys/devices/system/cpu/cpufreq/boost")
    print("on" if gov == "powersave" and boost in ("0", None) else "off")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "on":
        on()
    elif cmd == "off":
        off()
    elif cmd == "status":
        status()
    else:
        sys.exit("usage: powermon-saver on|off|status")
